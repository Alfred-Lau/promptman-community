# pnpm：把依赖平铺到顶层 node_modules（兼容某些工具对扁平布局的假设）
shamefully-hoist=true

# ── electron 本体二进制镜像 ──────────────────────────────────────────────
# 用国内 npmmirror 加速下载 electron-vXX.X.X-<platform>-<arch>.zip
# electron-builder 通过 @electron/get 读取此变量。
ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/

# ── electron-builder 附带二进制镜像 ──────────────────────────────────────
# dmg-builder / 7zip / appimage-builder 等托管在
# https://github.com/electron-userland/electron-builder-binaries/releases
# npmmirror 没有镜像这个仓库，必须保持官方 GitHub，否则会 404。
ELECTRON_BUILDER_BINARIES_MIRROR=https://github.com/electron-userland/electron-builder-binaries/releases/download/
